---
import BaseLayout from './BaseLayout.astro';
import { useTranslations, type Lang } from '../i18n/ui';
import { estimateReadingTime } from '../lib/readingTime';
import CategoryBadge from '../components/CategoryBadge.astro';
import Comments from '../components/Comments.astro';
import { SITE } from '../site.config';
import { getNextPost, type PostEntry } from '../lib/posts';

interface Props {
  entry: PostEntry;
  lang: Lang;
}

const { entry, lang } = Astro.props;
const t = useTranslations(lang);
const { title, description, pubDate, updatedDate, tags, category, heroImage } = entry.data;
const authed = await Astro.session?.get('authed');

const minutes = estimateReadingTime(entry.body ?? '', lang);
const dateLocale = lang === 'en' ? 'en-US' : 'ko-KR';
const dateOpts: Intl.DateTimeFormatOptions = { year: 'numeric', month: 'long', day: 'numeric' };
const formattedDate = pubDate.toLocaleDateString(dateLocale, dateOpts);
const formattedUpdated = updatedDate?.toLocaleDateString(dateLocale, dateOpts);

const backHref = lang === 'en' ? '/en/' : '/';
const basePath = lang === 'en' ? '/en' : '';

const nextPost = await getNextPost(lang, category, pubDate);
const nextHref = nextPost ? `${basePath}/blog/${nextPost.slug}/` : null;

const postURL = new URL(Astro.url.pathname, Astro.site).toString();
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  url: postURL,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  inLanguage: lang,
  author: { '@type': 'Person', name: SITE.author },
  publisher: { '@type': 'Person', name: SITE.author },
};
---

<BaseLayout
  title={title}
  description={description}
  lang={lang}
  image={heroImage}
  type="article"
  publishedTime={pubDate}
  modifiedTime={updatedDate}
  structuredData={structuredData}
>
  <article>
    <header class="post-header">
      <div class="post-header__top">
        <CategoryBadge category={category} lang={lang} />
        {authed && (
          <a class="post-edit-link" href={`/admin/edit/${entry.dbId}`}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 20h9" />
              <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4Z" />
            </svg>
            {t('post.edit')}
          </a>
        )}
      </div>
      <p class="post-header__meta">
        <time datetime={pubDate.toISOString()}>{formattedDate}</time>
        {' · '}{minutes} {t('post.readingTime')}
        {formattedUpdated && <> · {t('post.updated')} {formattedUpdated}</>}
      </p>
      <h1 class="post-header__title">{title}</h1>
      <p class="post-header__desc">{description}</p>
      {tags.length > 0 && (
        <div>
          {tags.map((tag) => (
            <span class="tag">{tag}</span>
          ))}
        </div>
      )}
    </header>

    <div class="prose">
      <slot />
    </div>

    {nextPost && nextHref && (
      <a class="next-post" href={nextHref}>
        <span class="next-post__label">{t('post.next')}</span>
        <span class="next-post__title">{nextPost.data.title} &rarr;</span>
      </a>
    )}

    <Comments postId={entry.id} lang={lang} />

    <a class="back-link" href={backHref}>&larr; {t('post.back')}</a>
  </article>
</BaseLayout>

<script>
  document.querySelectorAll<HTMLImageElement>('.prose img').forEach((img) => {
    img.addEventListener('contextmenu', (e) => e.preventDefault());
    img.addEventListener('dragstart', (e) => e.preventDefault());
  });
</script>

<style>
  .prose img {
    -webkit-user-drag: none;
    user-select: none;
  }

  .post-header__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .post-edit-link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--text-muted);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.3rem 0.75rem;
    text-decoration: none;
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .post-edit-link:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .post-edit-link svg {
    width: 0.9rem;
    height: 0.9rem;
  }

  .next-post {
    display: block;
    margin: 2.5rem 0;
    padding: 1.25rem 1.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-elevated);
    text-decoration: none;
  }

  .next-post__label {
    display: block;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 0.35rem;
  }

  .next-post__title {
    display: block;
    font-family: var(--font-serif);
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--text);
  }

  .next-post:hover .next-post__title {
    color: var(--accent);
  }
</style>
