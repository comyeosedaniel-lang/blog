---
import BaseLayout from './BaseLayout.astro';
import { useTranslations, type Lang } from '../i18n/ui';
import { estimateReadingTime } from '../lib/readingTime';
import CategoryBadge from '../components/CategoryBadge.astro';
import Comments from '../components/Comments.astro';
import PostCard from '../components/PostCard.astro';
import { SITE } from '../site.config';
import { getNextPost, getRelatedPosts, type PostEntry } from '../lib/posts';
import { getCategory } from '../lib/categories';
import { listAttachmentsForPost } from '../lib/attachments';
import { runSeoCheck } from '../lib/seoCheck';

interface Props {
  entry: PostEntry;
  lang: Lang;
}

function formatAttachmentSize(bytes: number): string {
  if (bytes < 1024 * 1024) return `${Math.round(bytes / 1024)}KB`;
  return `${(bytes / (1024 * 1024)).toFixed(1)}MB`;
}

const { entry, lang } = Astro.props;
const t = useTranslations(lang);
const { title, description, pubDate, updatedDate, tags, category, heroImage } = entry.data;
const authed = await Astro.session?.get('authed');

const minutes = estimateReadingTime(entry.body ?? '', lang);
const dateLocale = lang === 'en' ? 'en-US' : 'ko-KR';
const dateOpts: Intl.DateTimeFormatOptions = { year: 'numeric', month: 'long', day: 'numeric' };
const formattedDate = pubDate.toLocaleDateString(dateLocale, dateOpts);
const formattedUpdated = updatedDate?.toLocaleDateString(dateLocale, dateOpts);

const backHref = lang === 'en' ? '/en/' : '/';
const basePath = lang === 'en' ? '/en' : '';

const nextPost = await getNextPost(lang, category, pubDate);
const nextHref = nextPost ? `${basePath}/blog/${nextPost.slug}/` : null;

const relatedPosts = await getRelatedPosts(lang, tags, entry.slug, 4);
const categoryMeta = await getCategory(category);
const attachments = await listAttachmentsForPost(entry.dbId);

const seoChecks = runSeoCheck({
  title,
  description,
  slug: entry.slug,
  tags,
  heroImageUrl: heroImage,
  contentHtml: entry.body ?? '',
});

const postURL = new URL(Astro.url.pathname, Astro.site).toString();
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  url: postURL,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  inLanguage: lang,
  author: { '@type': 'Person', name: SITE.author },
  publisher: { '@type': 'Person', name: SITE.author },
};

const breadcrumbData = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: lang === 'en' ? 'Home' : '홈', item: `${SITE.url}${basePath}/` },
    ...(categoryMeta
      ? [
          {
            '@type': 'ListItem',
            position: 2,
            name: categoryMeta[lang],
            item: `${SITE.url}${basePath}/category/${categoryMeta.id}/`,
          },
        ]
      : []),
    { '@type': 'ListItem', position: categoryMeta ? 3 : 2, name: title, item: postURL },
  ],
};
---

<BaseLayout
  title={title}
  description={description}
  lang={lang}
  image={heroImage}
  type="article"
  publishedTime={pubDate}
  modifiedTime={updatedDate}
  structuredData={structuredData}
>
  <article>
    <header class="post-header">
      <div class="post-header__top">
        <CategoryBadge category={category} lang={lang} />
        {authed && (
          <a class="post-edit-link" href={`/admin/edit/${entry.dbId}`}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 20h9" />
              <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4Z" />
            </svg>
            {t('post.edit')}
          </a>
        )}
      </div>
      <p class="post-header__meta">
        <time datetime={pubDate.toISOString()}>{formattedDate}</time>
        {' · '}{minutes} {t('post.readingTime')}
        {formattedUpdated && <> · {t('post.updated')} {formattedUpdated}</>}
      </p>
      <h1 class="post-header__title">{title}</h1>
      <p class="post-header__desc">{description}</p>
      {tags.length > 0 && (
        <div>
          {tags.map((tag) => (
            <a class="tag" href={`${basePath}/tag/${encodeURIComponent(tag)}/`}>{tag}</a>
          ))}
        </div>
      )}
    </header>

    <div class="prose">
      <slot />
    </div>

    {attachments.length > 0 && (
      <div class="attachments-block">
        {attachments.map((a) => (
          <a class="download-btn" href={a.url} download>
            {a.label}
            <span class="download-btn__meta">{formatAttachmentSize(a.size)}</span>
          </a>
        ))}
      </div>
    )}

    <div class="share-buttons" data-share-title={title} data-share-copied-text={t('share.copied')}>
      <span class="share-buttons__label">{t('share.title')}</span>
      <button type="button" class="share-buttons__btn" data-action="native" hidden>{t('share.native')}</button>
      <a
        class="share-buttons__btn"
        href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(postURL)}`}
        target="_blank"
        rel="noopener noreferrer"
      >X</a>
      <button type="button" class="share-buttons__btn" data-action="copy">{t('share.copy')}</button>
    </div>

    {nextPost && nextHref && (
      <a class="next-post" href={nextHref}>
        <span class="next-post__label">{t('post.next')}</span>
        <span class="next-post__title">{nextPost.data.title} &rarr;</span>
      </a>
    )}

    {relatedPosts.length > 0 && (
      <section class="related-posts">
        <h2 class="related-posts__title">{t('post.related')}</h2>
        <ul class="post-list">
          {relatedPosts.map((related) => (
            <li>
              <PostCard entry={related} lang={lang} />
            </li>
          ))}
        </ul>
      </section>
    )}

    {authed && (
      <section class="seo-check">
        <h2 class="seo-check__title">SEO 점검 결과 (관리자에게만 보임)</h2>
        <ul class="seo-check__list">
          {seoChecks.map((item) => (
            <li class={`seo-check__item seo-check__item--${item.pass ? 'pass' : 'fail'}`}>
              <span class="seo-check__icon">{item.pass ? '✅' : '⚠'}</span>
              <span>
                <span class="seo-check__label">{item.label}</span>
                {item.detail && <span class="seo-check__detail">{item.detail}</span>}
              </span>
            </li>
          ))}
        </ul>
      </section>
    )}

    <Comments postId={entry.id} lang={lang} />

    <a class="back-link" href={backHref}>&larr; {t('post.back')}</a>
  </article>
</BaseLayout>

<script type="application/ld+json" set:html={JSON.stringify(breadcrumbData)} is:inline />

<script>
  document.querySelectorAll<HTMLImageElement>('.prose img').forEach((img) => {
    img.addEventListener('contextmenu', (e) => e.preventDefault());
    img.addEventListener('dragstart', (e) => e.preventDefault());
    img.loading = 'lazy';
    img.decoding = 'async';
  });

  document.querySelectorAll<HTMLElement>('.share-buttons').forEach((section) => {
    const title = section.dataset.shareTitle ?? document.title;
    const copiedText = section.dataset.shareCopiedText ?? '';
    const url = window.location.href;

    const nativeBtn = section.querySelector<HTMLButtonElement>('[data-action="native"]')!;
    if (navigator.share) {
      nativeBtn.hidden = false;
      nativeBtn.addEventListener('click', () => {
        navigator.share({ title, url }).catch(() => {});
      });
    }

    const copyBtn = section.querySelector<HTMLButtonElement>('[data-action="copy"]')!;
    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(url);
        const original = copyBtn.textContent;
        copyBtn.textContent = copiedText;
        setTimeout(() => {
          copyBtn.textContent = original;
        }, 2000);
      } catch {
        // clipboard API unavailable — nothing more we can do without a fallback UI
      }
    });
  });
</script>

<style>
  .prose img {
    -webkit-user-drag: none;
    user-select: none;
  }

  .post-header__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .post-edit-link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--text-muted);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.3rem 0.75rem;
    text-decoration: none;
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .post-edit-link:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .post-edit-link svg {
    width: 0.9rem;
    height: 0.9rem;
  }

  .next-post {
    display: block;
    margin: 2.5rem 0;
    padding: 1.25rem 1.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-elevated);
    text-decoration: none;
  }

  .next-post__label {
    display: block;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 0.35rem;
  }

  .next-post__title {
    display: block;
    font-family: var(--font-serif);
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--text);
  }

  .next-post:hover .next-post__title {
    color: var(--accent);
  }

  .share-buttons {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 2rem 0;
  }

  .share-buttons__label {
    font-size: 0.8125rem;
    color: var(--text-muted);
    margin-right: 0.25rem;
  }

  .share-buttons__btn {
    font: inherit;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--text);
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.35rem 0.9rem;
    cursor: pointer;
    text-decoration: none;
  }

  .share-buttons__btn:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .related-posts {
    margin: 2.5rem 0;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }

  .related-posts__title {
    font-size: 1rem;
    margin: 0 0 1rem;
  }

  .seo-check {
    margin: 2.5rem 0;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1rem 1.25rem;
    background: var(--bg-elevated);
  }

  .seo-check__title {
    font-size: 0.875rem;
    font-weight: 700;
    margin: 0 0 0.75rem;
  }

  .seo-check__list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .seo-check__item {
    display: flex;
    gap: 0.5rem;
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .seo-check__icon {
    flex: none;
  }

  .seo-check__item--pass .seo-check__icon {
    color: #2e7d32;
  }

  .seo-check__item--fail .seo-check__icon {
    color: #c0392b;
  }

  .seo-check__item--fail .seo-check__label {
    font-weight: 600;
  }

  .seo-check__detail {
    display: block;
    color: var(--text-muted);
    font-size: 0.8125rem;
  }
</style>
