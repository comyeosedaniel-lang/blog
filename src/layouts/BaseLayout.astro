---
import '@fontsource/pretendard/400.css';
import '@fontsource/pretendard/500.css';
import '@fontsource/pretendard/600.css';
import '@fontsource/pretendard/700.css';
import '@fontsource/noto-serif-kr/400.css';
import '@fontsource/noto-serif-kr/700.css';
import '../styles/global.css';

import { getImage } from 'astro:assets';
import { SITE, SEO_VERIFICATION, type CategoryId } from '../site.config';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CategoryTree from '../components/CategoryTree.astro';
import defaultOgSource from '../assets/hero.jpeg';
import type { Lang } from '../i18n/ui';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  description: string;
  lang: Lang;
  active?: 'home' | 'about';
  sidebar?: boolean;
  activeCategory?: CategoryId;
  image?: ImageMetadata;
  type?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  alternateUrl?: string;
  structuredData?: Record<string, unknown>;
}

const {
  title,
  description,
  lang,
  active,
  sidebar = false,
  activeCategory,
  image,
  type = 'website',
  publishedTime,
  modifiedTime,
  alternateUrl,
  structuredData,
} = Astro.props;

const pageTitle = title === SITE.title ? title : `${title} · ${SITE.title}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = await getImage({ src: image ?? defaultOgSource, width: 1200, height: 630, format: 'jpg' });
const ogImageURL = new URL(ogImage.src, Astro.site);
const ogLocale = lang === 'en' ? 'en_US' : 'ko_KR';
const alternateLang = lang === 'en' ? 'ko' : 'en';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE.title}
      href={lang === 'en' ? '/en/rss.xml' : '/rss.xml'}
    />
    <link rel="canonical" href={canonicalURL} />
    {alternateUrl && (
      <>
        <link rel="alternate" hreflang={alternateLang} href={alternateUrl} />
        <link rel="alternate" hreflang="x-default" href={lang === 'ko' ? canonicalURL.toString() : alternateUrl} />
      </>
    )}
    <meta name="generator" content={Astro.generator} />
    {SEO_VERIFICATION.google && <meta name="google-site-verification" content={SEO_VERIFICATION.google} />}
    {SEO_VERIFICATION.naver && <meta name="naver-site-verification" content={SEO_VERIFICATION.naver} />}

    <title>{pageTitle}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:site_name" content={SITE.title} />
    {type === 'article' && publishedTime && (
      <meta property="article:published_time" content={publishedTime.toISOString()} />
    )}
    {type === 'article' && modifiedTime && (
      <meta property="article:modified_time" content={modifiedTime.toISOString()} />
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    {structuredData && (
      <script type="application/ld+json" set:html={JSON.stringify(structuredData)} is:inline />
    )}

    <script is:inline>
      (function () {
        var stored = localStorage.getItem('theme');
        var theme = stored || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body>
    <Header lang={lang} active={active} />
    <slot name="hero" />
    <main class={sidebar ? 'container container--wide' : 'container'}>
      {sidebar ? (
        <div class="layout-split">
          <CategoryTree lang={lang} activeCategory={activeCategory} />
          <div class="layout-split__content">
            <slot />
          </div>
        </div>
      ) : (
        <slot />
      )}
    </main>
    <Footer lang={lang} />
  </body>
</html>
