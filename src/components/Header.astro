---
import { SITE } from '../site.config';
import { useTranslations, type Lang } from '../i18n/ui';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  lang: Lang;
  active?: 'home' | 'about';
}

const { lang, active } = Astro.props;
const t = useTranslations(lang);

const home = lang === 'en' ? '/en/' : '/';
const about = lang === 'en' ? '/en/about/' : '/about/';
const langSwitch = lang === 'en' ? '/' : '/en/';
const authed = await Astro.session?.get('authed');
---

<header class="site-header">
  <div class="container site-header__row">
    <p class="site-header__title">
      <a href={home}>{SITE.title}</a>
    </p>
    <nav class="site-nav" aria-label="Primary">
      <a href={home} aria-current={active === 'home' ? 'page' : undefined}>{t('nav.home')}</a>
      <a href={about} aria-current={active === 'about' ? 'page' : undefined}>{t('nav.about')}</a>
      <a href={langSwitch} id="lang-switch" data-lang={lang === 'en' ? 'ko' : 'en'}>{t('nav.lang')}</a>
      {authed ? (
        <>
          <a href="/admin/new" class="icon-btn" aria-label="새 글쓰기" title="새 글쓰기">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <path d="M12 5v14M5 12h14" />
            </svg>
          </a>
          <a href="/admin" class="icon-btn" aria-label="관리자" title="관리자">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="3"></circle>
              <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
            </svg>
          </a>
          <form method="POST" action="/api/logout" class="site-nav__logout-form">
            <button type="submit" class="icon-btn" aria-label="로그아웃" title="로그아웃">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                <polyline points="16 17 21 12 16 7"></polyline>
                <line x1="21" y1="12" x2="9" y2="12"></line>
              </svg>
            </button>
          </form>
        </>
      ) : (
        <a href="/admin/login">로그인</a>
      )}
      <ThemeToggle lang={lang} />
    </nav>
  </div>
</header>

<script>
  document.getElementById('lang-switch')?.addEventListener('click', (e) => {
    const target = e.currentTarget as HTMLElement;
    localStorage.setItem('lang-pref', target.dataset.lang ?? 'ko');
  });
</script>
