---
import { SITE } from '../site.config';
import { useTranslations, type Lang } from '../i18n/ui';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  lang: Lang;
  active?: 'home' | 'about';
}

const { lang, active } = Astro.props;
const t = useTranslations(lang);

const home = lang === 'en' ? '/en/' : '/';
const about = lang === 'en' ? '/en/about/' : '/about/';
const langSwitch = lang === 'en' ? '/' : '/en/';
const authed = await Astro.session?.get('authed');
---

<header class="site-header">
  <div class="container site-header__row">
    <p class="site-header__title">
      <a href={home}>{SITE.title}</a>
    </p>
    <nav class="site-nav" aria-label="Primary">
      <a href={home} aria-current={active === 'home' ? 'page' : undefined}>{t('nav.home')}</a>
      <a href={about} aria-current={active === 'about' ? 'page' : undefined}>{t('nav.about')}</a>
      <a href={langSwitch} id="lang-switch" data-lang={lang === 'en' ? 'ko' : 'en'}>{t('nav.lang')}</a>
      {authed ? (
        <>
          <a href="/admin" class="site-nav__write-btn">관리자</a>
          <a href="/admin/new" class="icon-btn" aria-label="새 글쓰기" title="새 글쓰기">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <path d="M12 5v14M5 12h14" />
            </svg>
          </a>
        </>
      ) : (
        <a href="/admin/login">로그인</a>
      )}
      <ThemeToggle lang={lang} />
    </nav>
  </div>
</header>

<script>
  document.getElementById('lang-switch')?.addEventListener('click', (e) => {
    const target = e.currentTarget as HTMLElement;
    localStorage.setItem('lang-pref', target.dataset.lang ?? 'ko');
  });
</script>
