---
import { getCategory } from '../lib/categories';
import type { Lang } from '../i18n/ui';

interface Props {
  category: string;
  lang: Lang;
}

const { category, lang } = Astro.props;
const meta = await getCategory(category);
const href = lang === 'en' ? `/en/category/${category}/` : `/category/${category}/`;
---

{meta && <a class="category-badge" href={href}>{meta[lang]}</a>}
