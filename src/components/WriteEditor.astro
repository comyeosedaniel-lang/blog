---
import { listCategories } from '../lib/categories';
import type { AdminPostFull } from '../lib/posts';
import type { Attachment } from '../lib/attachments';

interface Props {
  post?: AdminPostFull | null;
  initialTitle?: string;
  initialSourceLink?: string;
  attachments?: Attachment[];
}

const { post = null, initialTitle = '', initialSourceLink = '', attachments = [] } = Astro.props;
const isEdit = post !== null;
const categories = await listCategories();

function formatSize(bytes: number): string {
  if (bytes < 1024 * 1024) return `${Math.round(bytes / 1024)}KB`;
  return `${(bytes / (1024 * 1024)).toFixed(1)}MB`;
}
---

<div
  class="write-editor"
  data-post-id={post?.id ?? ''}
  data-hero-url={post?.heroImageUrl ?? ''}
  data-source-link={initialSourceLink}
>
  <div class="write-editor__row">
    <label class="write-field write-field--grow">
      <span>제목</span>
      <input type="text" id="title" value={post?.title ?? initialTitle} placeholder="제목을 입력하세요" />
    </label>
  </div>

  <div class="write-editor__row">
    <label class="write-field write-field--grow">
      <span>주소(슬러그)</span>
      <div class="write-field__inline">
        <input type="text" id="slug" value={post?.slug ?? ''} disabled={isEdit} placeholder="my-post" />
        {!isEdit && (
          <button type="button" id="slug-from-title" class="write-btn">제목에서 만들기</button>
        )}
      </div>
    </label>

    <label class="write-field">
      <span>언어</span>
      <select id="lang">
        <option value="ko" selected={(post?.lang ?? 'ko') === 'ko'}>한국어</option>
        <option value="en" selected={post?.lang === 'en'}>English</option>
      </select>
    </label>

    <label class="write-field">
      <span>카테고리</span>
      <select id="category">
        {categories.map((c) => (
          <option value={c.id} selected={(post?.category ?? categories[0]?.id) === c.id}>{c.ko}</option>
        ))}
      </select>
    </label>
  </div>

  <label class="write-field">
    <span>설명 (목록·검색에 노출)</span>
    <textarea id="description" rows="2">{post?.description ?? ''}</textarea>
  </label>

  <label class="write-field">
    <span>태그 (쉼표로 구분)</span>
    <input type="text" id="tags" value={(post?.tags ?? []).join(', ')} placeholder="태그1, 태그2" />
  </label>

  <label class="write-field">
    <span>대문 이미지</span>
    <input type="file" id="hero-input" accept="image/*" />
    <img id="hero-preview" src={post?.heroImageUrl ?? ''} hidden={!post?.heroImageUrl} alt="" />
    <input type="hidden" id="heroImageUrl" value={post?.heroImageUrl ?? ''} />
  </label>

  <div class="write-field">
    <span>첨부파일 (글 안에 다운로드 버튼으로 자동 표시돼요)</span>
    {isEdit ? (
      <>
        <ul id="attachments-list" class="attachments-list">
          {attachments.map((a) => (
            <li class="attachments-list__row" data-id={a.id}>
              <a href={a.url} target="_blank" rel="noopener noreferrer">{a.label}</a>
              <span class="attachments-list__meta">{formatSize(a.size)}</span>
              <button type="button" class="attachments-list__delete">삭제</button>
            </li>
          ))}
        </ul>
        <div class="attachments-add">
          <input type="text" id="attachment-label" placeholder="이름 (예: 설치 파일)" />
          <input type="file" id="attachment-file" />
          <button type="button" id="attachment-upload-btn" class="write-btn">추가</button>
        </div>
        <p id="attachment-status" class="write-editor__status" role="status"></p>
      </>
    ) : (
      <p class="write-editor__hint">글을 먼저 저장한 후 첨부파일을 추가할 수 있어요.</p>
    )}
  </div>

  <div class="write-toolbar">
    <button type="button" class="write-toolbar__btn" data-cmd="bold" title="굵게"><strong>B</strong></button>
    <button type="button" class="write-toolbar__btn" data-cmd="italic" title="기울임"><em>I</em></button>
    <button type="button" class="write-toolbar__btn" data-cmd="h2" title="제목 2">H2</button>
    <button type="button" class="write-toolbar__btn" data-cmd="h3" title="제목 3">H3</button>
    <button type="button" class="write-toolbar__btn" data-cmd="bullet" title="글머리 기호">•</button>
    <button type="button" class="write-toolbar__btn" data-cmd="ordered" title="번호 매기기">1.</button>
    <button type="button" class="write-toolbar__btn" data-cmd="blockquote" title="인용">"</button>
    <button type="button" class="write-toolbar__btn" data-cmd="code" title="코드">{'<>'}</button>
    <button type="button" class="write-toolbar__btn" data-cmd="link" title="링크">🔗</button>
    <button type="button" class="write-toolbar__btn" data-cmd="image" title="이미지">🖼</button>
    <button type="button" class="write-toolbar__btn" data-cmd="undo" title="실행 취소">↶</button>
    <button type="button" class="write-toolbar__btn" data-cmd="redo" title="다시 실행">↷</button>
  </div>
  <input type="file" id="image-input" accept="image/*" hidden />

  <div id="editor" class="write-prosemirror"></div>
  <div id="preview-pane" class="prose write-preview" hidden></div>

  <p id="autosave-banner" class="autosave-banner" hidden>
    이전에 저장하지 못한 내용이 있어요.
    <button type="button" id="autosave-restore" class="write-btn">불러오기</button>
    <button type="button" id="autosave-discard" class="write-btn">무시하기</button>
  </p>

  <div class="write-editor__actions">
    <button type="button" id="toggle-preview" class="write-btn">미리보기</button>
    <button type="button" id="save-draft" class="write-btn">임시저장</button>
    <button type="button" id="publish" class="write-btn write-btn--primary">발행</button>
    {isEdit && (
      <button type="button" id="delete-post" class="write-btn write-btn--danger">삭제</button>
    )}
  </div>
  <p id="write-status" class="write-editor__status" role="status"></p>

  <div id="seo-check" class="seo-check" hidden>
    <h2 class="seo-check__title">SEO 점검 결과</h2>
    <ul id="seo-check-list" class="seo-check__list"></ul>
  </div>
</div>

<script type="application/json" id="initial-data" set:html={JSON.stringify(post)} is:inline />

<script>
  import '../scripts/editor.client';
</script>

<style>
  .write-editor {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    max-width: 44rem;
  }

  .write-editor__row {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .write-field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  .write-field--grow {
    flex: 1 1 16rem;
  }

  .write-field__inline {
    display: flex;
    gap: 0.5rem;
  }

  .write-field input[type='text'],
  .write-field input[type='file'],
  .write-field select,
  .write-field textarea {
    font: inherit;
    font-size: 0.9375rem;
    color: var(--text);
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 0.55rem 0.7rem;
  }

  .write-field input:disabled {
    opacity: 0.6;
  }

  #hero-preview {
    max-width: 16rem;
    margin-top: 0.5rem;
    border-radius: var(--radius);
  }

  .write-editor__hint {
    margin: 0;
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  .attachments-list {
    list-style: none;
    margin: 0 0 0.6rem;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .attachments-list__row {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.5rem 0.7rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    font-size: 0.875rem;
  }

  .attachments-list__row a {
    color: var(--text);
    font-weight: 600;
  }

  .attachments-list__meta {
    color: var(--text-muted);
    font-size: 0.75rem;
  }

  .attachments-list__delete {
    margin-left: auto;
    font: inherit;
    font-size: 0.75rem;
    color: #c0392b;
    background: none;
    border: none;
    cursor: pointer;
  }

  .attachments-add {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .attachments-add input[type='text'] {
    flex: 1 1 12rem;
    font: inherit;
    font-size: 0.9375rem;
    color: var(--text);
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 0.5rem 0.7rem;
  }

  .write-toolbar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    padding: 0.5rem;
    border: 1px solid var(--border);
    border-bottom: none;
    border-radius: var(--radius) var(--radius) 0 0;
    background: var(--bg-elevated);
  }

  .write-toolbar__btn {
    min-width: 2rem;
    height: 2rem;
    padding: 0 0.4rem;
    font-size: 0.875rem;
    color: var(--text);
    background: transparent;
    border: 1px solid transparent;
    border-radius: 0.35rem;
    cursor: pointer;
  }

  .write-toolbar__btn:hover,
  .write-toolbar__btn.is-active {
    border-color: var(--border);
    background: var(--bg);
  }

  .write-prosemirror {
    min-height: 20rem;
    padding: 1rem 1.1rem;
    border: 1px solid var(--border);
    border-radius: 0 0 var(--radius) var(--radius);
    background: var(--bg-elevated);
    font-size: 1.0625rem;
    line-height: 1.75;
  }

  .write-prosemirror :global(.ProseMirror) {
    outline: none;
    min-height: 20rem;
  }

  .write-prosemirror :global(p.is-editor-empty:first-child::before) {
    content: attr(data-placeholder);
    float: left;
    color: var(--text-muted);
    pointer-events: none;
    height: 0;
  }

  .write-prosemirror :global(img) {
    max-width: 100%;
    border-radius: var(--radius);
  }

  .write-preview {
    padding: 1rem 1.1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-elevated);
  }

  .autosave-banner {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0;
    padding: 0.75rem 1rem;
    border: 1px solid var(--accent);
    border-radius: var(--radius);
    font-size: 0.875rem;
    color: var(--text);
  }

  .write-editor__actions {
    display: flex;
    gap: 0.6rem;
  }

  .write-btn {
    font: inherit;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text);
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 0.5rem 1rem;
    cursor: pointer;
  }

  .write-btn--primary {
    color: var(--accent-contrast);
    background: var(--accent);
    border-color: var(--accent);
  }

  .write-btn--danger {
    color: #c0392b;
    margin-left: auto;
  }

  .write-btn:hover {
    opacity: 0.9;
  }

  .write-editor__status {
    min-height: 1.2em;
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  .write-editor__status--error {
    font-weight: 700;
    color: #c0392b;
  }

  .seo-check {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1rem 1.1rem;
    background: var(--bg-elevated);
  }

  .seo-check__title {
    font-size: 0.9375rem;
    font-weight: 700;
    margin: 0 0 0.75rem;
  }

  .seo-check__list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .seo-check__item {
    display: flex;
    gap: 0.5rem;
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .seo-check__icon {
    flex: none;
  }

  .seo-check__item--pass .seo-check__icon {
    color: #2e7d32;
  }

  .seo-check__item--fail .seo-check__icon {
    color: #c0392b;
  }

  .seo-check__item--fail .seo-check__label {
    font-weight: 600;
  }

  .seo-check__detail {
    display: block;
    color: var(--text-muted);
    font-size: 0.8125rem;
  }
</style>
