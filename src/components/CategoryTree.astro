---
import { listPosts } from '../lib/posts';
import { listCategories } from '../lib/categories';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  activeCategory?: string;
}

const { lang, activeCategory } = Astro.props;
const t = useTranslations(lang);
const basePath = lang === 'en' ? '/en' : '';

const MAX_POSTS_SHOWN = 5;

const [posts, categories] = await Promise.all([listPosts({ lang }), listCategories()]);

const grouped = categories.map((cat) => {
  const categoryPosts = posts.filter((p) => p.data.category === cat.id);
  return {
    id: cat.id,
    label: lang === 'en' ? cat.en : cat.ko,
    posts: categoryPosts,
    remaining: Math.max(0, categoryPosts.length - MAX_POSTS_SHOWN),
  };
});

const moreLabel = (n: number) => (lang === 'en' ? `+${n} more` : `+${n}개 더보기`);
const lessLabel = lang === 'en' ? 'Show less' : '접기';
---

<nav class="category-tree" aria-label={lang === 'en' ? 'Categories' : '카테고리'}>
  <a class="category-tree__all" href={`${basePath}/`}>{t('category.all')}</a>
  {
    grouped.map((cat) => (
      <div class="category-tree__group">
        <a
          class="category-tree__category"
          href={`${basePath}/category/${cat.id}/`}
          aria-current={cat.id === activeCategory ? 'page' : undefined}
        >
          {cat.label}
        </a>
        {cat.posts.length > 0 && (
          <ul class="category-tree__posts">
            {cat.posts.map((entry, i) => {
              const slug = entry.id.replace(/^(ko|en)\//, '');
              const href = `${basePath}/blog/${slug}/`;
              const isExtra = i >= MAX_POSTS_SHOWN;
              return (
                <li class={isExtra ? 'category-tree__extra-post' : undefined} hidden={isExtra}>
                  <a href={href} class="category-tree__post-title" title={entry.data.title}>
                    {entry.data.title}
                  </a>
                </li>
              );
            })}
            {cat.remaining > 0 && (
              <li>
                <button
                  type="button"
                  class="category-tree__toggle"
                  data-more-label={moreLabel(cat.remaining)}
                  data-less-label={lessLabel}
                >
                  {moreLabel(cat.remaining)}
                </button>
              </li>
            )}
          </ul>
        )}
      </div>
    ))
  }
</nav>

<script>
  document.querySelectorAll<HTMLButtonElement>('.category-tree__toggle').forEach((btn) => {
    btn.addEventListener('click', () => {
      const group = btn.closest('.category-tree__group');
      const extraPosts = group?.querySelectorAll<HTMLLIElement>('.category-tree__extra-post');
      const isExpanding = extraPosts?.[0]?.hidden ?? false;
      extraPosts?.forEach((li) => (li.hidden = !isExpanding));
      btn.textContent = (isExpanding ? btn.dataset.lessLabel : btn.dataset.moreLabel) ?? '';
    });
  });
</script>

<style>
  .category-tree {
    position: sticky;
    top: 5.5rem;
    font-size: 0.875rem;
  }

  .category-tree__all {
    display: block;
    font-weight: 600;
    color: var(--text);
    text-decoration: none;
    margin-bottom: 1.25rem;
  }

  .category-tree__all:hover {
    color: var(--accent);
  }

  .category-tree__group {
    margin-bottom: 1.5rem;
  }

  .category-tree__category {
    display: block;
    font-weight: 600;
    font-size: 0.75rem;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--text-muted);
    text-decoration: none;
    margin-bottom: 0.5rem;
  }

  .category-tree__category:hover,
  .category-tree__category[aria-current='page'] {
    color: var(--accent);
  }

  .category-tree__posts {
    list-style: none;
    margin: 0;
    padding: 0;
    border-left: 1px solid var(--border);
  }

  .category-tree__post-title {
    display: block;
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--text-muted);
    text-decoration: none;
    padding: 0.3rem 0 0.3rem 0.85rem;
  }

  .category-tree__post-title:hover {
    color: var(--accent);
  }

  .category-tree__toggle {
    display: block;
    width: 100%;
    text-align: left;
    color: var(--accent);
    background: none;
    border: none;
    font: inherit;
    font-size: 0.8125rem;
    padding: 0.3rem 0 0.3rem 0.85rem;
    cursor: pointer;
  }

  .category-tree__toggle:hover {
    text-decoration: underline;
  }

  @media (max-width: 48rem) {
    .category-tree {
      position: static;
    }
  }
</style>
