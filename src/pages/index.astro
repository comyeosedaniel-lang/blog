---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import Hero from '../components/Hero.astro';
import { SITE } from '../site.config';
import { useTranslations } from '../i18n/ui';

const t = useTranslations('ko');

const posts = (await getCollection('blog', ({ id, data }) => {
  return id.startsWith('ko/') && (import.meta.env.DEV || !data.draft);
})).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.title,
  url: `${SITE.url}/`,
  inLanguage: 'ko',
};
---

<BaseLayout
  title={SITE.title}
  description={SITE.description.ko}
  lang="ko"
  active="home"
  sidebar
  alternateUrl={`${SITE.url}/en/`}
  structuredData={structuredData}
>
  <Hero slot="hero" title={SITE.title} />
  <h1 class="page-title">{t('home.recent')}</h1>
  {posts.length === 0 ? (
    <p class="empty-state">{t('home.empty')}</p>
  ) : (
    <ul class="post-list">
      {posts.map((entry) => (
        <li>
          <PostCard entry={entry} lang="ko" />
        </li>
      ))}
    </ul>
  )}
</BaseLayout>
