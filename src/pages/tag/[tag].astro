---
import { getPostsByTag } from '../../lib/posts';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import Pagination from '../../components/Pagination.astro';
import { SITE } from '../../site.config';
import { useTranslations } from '../../i18n/ui';

const PAGE_SIZE = 10;

const { tag: rawTag } = Astro.params;
const tag = rawTag ? decodeURIComponent(rawTag) : '';

if (!tag) {
  return Astro.rewrite('/404');
}

const t = useTranslations('ko');
const allPosts = await getPostsByTag('ko', tag);
const currentPage = Math.max(1, Number(Astro.url.searchParams.get('page') ?? '1') || 1);
const totalPages = Math.max(1, Math.ceil(allPosts.length / PAGE_SIZE));
const posts = allPosts.slice((currentPage - 1) * PAGE_SIZE, currentPage * PAGE_SIZE);
---

<BaseLayout title={`#${tag}`} description={SITE.description.ko} lang="ko">
  <h1 class="page-title">#{tag}</h1>
  {posts.length === 0 ? (
    <p class="empty-state">{t('home.empty')}</p>
  ) : (
    <ul class="post-list">
      {posts.map((entry) => (
        <li>
          <PostCard entry={entry} lang="ko" />
        </li>
      ))}
    </ul>
  )}
  <Pagination currentPage={currentPage} totalPages={totalPages} baseHref={`/tag/${encodeURIComponent(tag)}/`} />
</BaseLayout>
