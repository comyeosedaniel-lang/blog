---
import { env } from 'cloudflare:workers';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdminNav from '../../components/AdminNav.astro';
import { SITE } from '../../site.config';

export const prerender = false;

interface FeedItemRow {
  id: number;
  source: string;
  title: string;
  link: string;
  summary: string | null;
  published_at: string | null;
  fetched_at: string;
}

const { results } = await env.DB.prepare(
  'SELECT id, source, title, link, summary, published_at, fetched_at FROM feed_items WHERE reviewed = 0 ORDER BY fetched_at DESC LIMIT 100',
).all<FeedItemRow>();
---

<BaseLayout title="뉴스 피드" description={SITE.description.ko} lang="ko">
  <AdminNav active="feed" />
  <div class="feed-admin">
    <div class="feed-admin__head">
      <h1 class="page-title">뉴스 피드 검토</h1>
      <button type="button" id="refresh-btn" class="write-btn">지금 수집하기</button>
    </div>
    <p class="feed-admin__hint">6시간마다 자동으로 새 글을 모아와요. 여기서는 확인만 할 뿐 자동으로 발행되지 않아요.</p>

    {results.length === 0 ? (
      <p class="empty-state">검토할 새 글이 없어요.</p>
    ) : (
      <ul class="feed-admin__list" id="feed-list">
        {results.map((item) => (
          <li class="feed-admin__item" data-id={item.id}>
            <div class="feed-admin__meta">
              <span class="feed-admin__source">{item.source}</span>
              {item.published_at && <time>{new Date(item.published_at).toLocaleDateString('ko-KR')}</time>}
            </div>
            <a class="feed-admin__title" href={item.link} target="_blank" rel="noopener noreferrer">{item.title}</a>
            {item.summary && <p class="feed-admin__summary">{item.summary}</p>}
            <div class="feed-admin__actions">
              <a class="write-btn write-btn--primary" href={`/admin/new?title=${encodeURIComponent(item.title)}&sourceLink=${encodeURIComponent(item.link)}`}>
                이 글로 초안 만들기
              </a>
              <button type="button" class="write-btn feed-admin__mark-read">읽음 표시</button>
              <button type="button" class="write-btn write-btn--danger feed-admin__delete">삭제</button>
            </div>
          </li>
        ))}
      </ul>
    )}

    <p id="feed-status" class="feed-admin__status" role="status"></p>
  </div>
</BaseLayout>

<script>
  const list = document.getElementById('feed-list');
  const status = document.getElementById('feed-status') as HTMLParagraphElement;
  const refreshBtn = document.getElementById('refresh-btn') as HTMLButtonElement;

  list?.addEventListener('click', async (e) => {
    const target = e.target as HTMLElement;
    const item = target.closest<HTMLLIElement>('.feed-admin__item');
    if (!item) return;
    const id = item.dataset.id;

    if (target.classList.contains('feed-admin__mark-read')) {
      const res = await fetch(`/api/feed-items/${id}`, { method: 'PATCH' });
      if (res.ok) item.remove();
    }

    if (target.classList.contains('feed-admin__delete')) {
      if (!window.confirm('이 항목을 삭제할까요?')) return;
      const res = await fetch(`/api/feed-items/${id}`, { method: 'DELETE' });
      if (res.ok) item.remove();
    }
  });

  refreshBtn?.addEventListener('click', async () => {
    refreshBtn.disabled = true;
    status.textContent = '수집하는 중...';
    try {
      const res = await fetch('/api/feed/refresh', { method: 'POST' });
      const data = (await res.json().catch(() => ({}))) as { totalInserted?: number };
      status.textContent = res.ok ? `${data.totalInserted ?? 0}개 새로 수집했어요. 새로고침할게요...` : '수집에 실패했어요.';
      if (res.ok) setTimeout(() => window.location.reload(), 1000);
    } catch {
      status.textContent = '수집 중 문제가 생겼어요.';
    } finally {
      refreshBtn.disabled = false;
    }
  });
</script>

<style>
  .feed-admin__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.5rem;
  }

  .feed-admin__head .page-title {
    margin: 0;
  }

  .feed-admin__hint {
    font-size: 0.8125rem;
    color: var(--text-muted);
    margin-bottom: 1.75rem;
  }

  .feed-admin__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .feed-admin__item {
    padding: 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .feed-admin__meta {
    display: flex;
    gap: 0.6rem;
    align-items: center;
    font-size: 0.75rem;
    color: var(--text-muted);
    margin-bottom: 0.4rem;
  }

  .feed-admin__source {
    font-weight: 600;
  }

  .feed-admin__title {
    display: block;
    font-family: var(--font-serif);
    font-size: 1.0625rem;
    font-weight: 700;
    color: var(--text);
    text-decoration: none;
    margin-bottom: 0.4rem;
  }

  .feed-admin__title:hover {
    color: var(--accent);
  }

  .feed-admin__summary {
    font-size: 0.875rem;
    color: var(--text-muted);
    margin: 0 0 0.75rem;
  }

  .feed-admin__actions {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .write-btn {
    font: inherit;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--text);
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 0.45rem 0.85rem;
    text-decoration: none;
    cursor: pointer;
    display: inline-block;
  }

  .write-btn--primary {
    color: var(--accent-contrast);
    background: var(--accent);
    border-color: var(--accent);
  }

  .write-btn--danger {
    color: #c0392b;
  }

  .write-btn:hover {
    opacity: 0.9;
  }

  .feed-admin__status {
    min-height: 1.2em;
    margin-top: 1rem;
    font-size: 0.875rem;
    color: var(--text-muted);
  }
</style>
