---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../site.config';
import { listCategories } from '../../lib/categories';
import { getPageBySlug } from '../../lib/pages';

const title = 'About';
const categories = await listCategories();
const customIntro = await getPageBySlug('en', 'about');
---

<BaseLayout
  title={title}
  description={SITE.description.en}
  lang="en"
  active="about"
  alternateUrl={`${SITE.url}/about/`}
>
  <h1 class="page-title">{title}</h1>
  <div class="prose">
    {customIntro ? (
      <Fragment set:html={customIntro.contentHtml} />
    ) : (
      <p>
        <strong>{SITE.title}</strong> is a space for {SITE.description.en} things learned while
        building software, notes on books, everyday life, and computer-related news.
      </p>
    )}
    <p>Here's what you'll find here.</p>
    <ul>
      {categories.map((c) => (
        <li><a href={`/en/category/${c.id}/`}>{c.en}</a></li>
      ))}
    </ul>
    <p>
      New posts are available via <a href="/en/rss.xml">RSS</a> or email subscription below,
      and comments are open on every post. This blog is written in both Korean and{' '}
      <a href="/about/">한국어</a>.
    </p>
    <p>
      The source code for this blog is on{' '}
      <a href={SITE.github} target="_blank" rel="noopener noreferrer">GitHub</a>.
    </p>
  </div>
</BaseLayout>
