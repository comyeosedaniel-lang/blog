---
import { listPosts } from '../../../lib/posts';
import { getCategory } from '../../../lib/categories';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostCard from '../../../components/PostCard.astro';
import { SITE } from '../../../site.config';
import { useTranslations } from '../../../i18n/ui';

const { category } = Astro.params;
const meta = category ? await getCategory(category) : null;

if (!meta) {
  return Astro.rewrite('/404');
}

const t = useTranslations('en');
const posts = await listPosts({ lang: 'en', category: meta.id });
---

<BaseLayout title={meta.en} description={SITE.description.en} lang="en" sidebar activeCategory={meta.id}>
  <h1 class="page-title">{meta.en}</h1>
  {posts.length === 0 ? (
    <p class="empty-state">{t('home.empty')}</p>
  ) : (
    <ul class="post-list">
      {posts.map((entry) => (
        <li>
          <PostCard entry={entry} lang="en" />
        </li>
      ))}
    </ul>
  )}
</BaseLayout>
