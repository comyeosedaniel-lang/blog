---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostCard from '../../../components/PostCard.astro';
import { SITE, CATEGORIES } from '../../../site.config';
import { useTranslations } from '../../../i18n/ui';

export async function getStaticPaths() {
  return CATEGORIES.map((category) => ({ params: { category: category.id } }));
}

const { category } = Astro.params;
const meta = CATEGORIES.find((c) => c.id === category)!;
const t = useTranslations('en');

const posts = (await getCollection('blog', ({ id, data }) => {
  return id.startsWith('en/') && data.category === category && (import.meta.env.DEV || !data.draft);
})).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title={meta.en} description={SITE.description.en} lang="en">
  <nav class="category-nav" aria-label="Categories">
    <a href="/en/">{t('category.all')}</a>
    {CATEGORIES.map((c) => (
      <a href={`/en/category/${c.id}/`} aria-current={c.id === category ? 'page' : undefined}>{c.en}</a>
    ))}
  </nav>
  <h1 class="page-title">{meta.en}</h1>
  {posts.length === 0 ? (
    <p class="empty-state">{t('home.empty')}</p>
  ) : (
    <ul class="post-list">
      {posts.map((entry) => (
        <li>
          <PostCard entry={entry} lang="en" />
        </li>
      ))}
    </ul>
  )}
</BaseLayout>
