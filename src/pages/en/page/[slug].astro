---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { SITE } from '../../../site.config';
import { getPageBySlug } from '../../../lib/pages';

export const prerender = false;

const { slug } = Astro.params;
// "about" has its own canonical route at /en/about/ — don't also serve it here as a duplicate URL.
const page = slug && slug !== 'about' ? await getPageBySlug('en', slug) : null;

if (!page) {
  return Astro.rewrite('/404');
}
---

<BaseLayout title={page.title} description={SITE.description.en} lang="en">
  <h1 class="page-title">{page.title}</h1>
  <div class="prose" set:html={page.contentHtml} />
</BaseLayout>
