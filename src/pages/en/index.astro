---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import Hero from '../../components/Hero.astro';
import { SITE, CATEGORIES } from '../../site.config';
import { useTranslations } from '../../i18n/ui';

const t = useTranslations('en');

const posts = (await getCollection('blog', ({ id, data }) => {
  return id.startsWith('en/') && (import.meta.env.DEV || !data.draft);
})).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title={SITE.title} description={SITE.description.en} lang="en" active="home">
  <Hero slot="hero" title={SITE.title} />
  <nav class="category-nav" aria-label="Categories">
    <a href="/en/" aria-current="page">{t('category.all')}</a>
    {CATEGORIES.map((c) => (
      <a href={`/en/category/${c.id}/`}>{c.en}</a>
    ))}
  </nav>
  <h1 class="page-title">{t('home.recent')}</h1>
  {posts.length === 0 ? (
    <p class="empty-state">{t('home.empty')}</p>
  ) : (
    <ul class="post-list">
      {posts.map((entry) => (
        <li>
          <PostCard entry={entry} lang="en" />
        </li>
      ))}
    </ul>
  )}
</BaseLayout>
