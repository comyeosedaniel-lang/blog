---
import { listPosts } from '../../lib/posts';
import { getCategory } from '../../lib/categories';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { SITE } from '../../site.config';
import { useTranslations } from '../../i18n/ui';

const { category } = Astro.params;
const meta = category ? await getCategory(category) : null;

if (!meta) {
  return Astro.rewrite('/404');
}

const t = useTranslations('ko');
const posts = await listPosts({ lang: 'ko', category: meta.id });
---

<BaseLayout title={meta.ko} description={SITE.description.ko} lang="ko" sidebar activeCategory={meta.id}>
  <h1 class="page-title">{meta.ko}</h1>
  {posts.length === 0 ? (
    <p class="empty-state">{t('home.empty')}</p>
  ) : (
    <ul class="post-list">
      {posts.map((entry) => (
        <li>
          <PostCard entry={entry} lang="ko" />
        </li>
      ))}
    </ul>
  )}
</BaseLayout>
