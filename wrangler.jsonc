{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-07-28",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "mylineal-blog",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "mylineal-content",
			"database_id": "79bdaea5-96e3-4361-bc2d-ec1097c20a62"
		}
	],
	"r2_buckets": [
		{
			"binding": "UPLOADS",
			"bucket_name": "mylineal-uploads"
		}
	],
	"observability": {
		"enabled": true
	}
}